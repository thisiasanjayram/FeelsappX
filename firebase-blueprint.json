{
  "entities": {
    "GeneratedItem": {
      "title": "Generated Item",
      "description": "An item generated by the AI (Photo, Avatar, or Video)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "type": { "type": "string", "enum": ["Photos", "Avatars", "Videos"] },
        "emotion": { "type": "string" },
        "url": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "timestamp": { "type": "integer" }
      },
      "required": ["userId", "type", "emotion", "url", "timestamp"]
    }
  },
  "firestore": {
    "items": { "schema": "GeneratedItem", "description": "Collection of all generated items" }
  }
}
